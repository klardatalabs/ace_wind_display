# Copy to .env and fill in. Never commit .env.

PORT=4100
# Public URL of this site, used in the hoardings' QR codes (e.g. https://westonwind.org)
PUBLIC_ORIGIN=
# Set to 1 when running behind a reverse proxy (correct client IPs for rate limits)
TRUST_PROXY=0

# Protects /admin and /api/admin. Always set this on a public deployment.
ADMIN_TOKEN=

# Signs anonymous chat sessions. Set a long random value so chats survive restarts.
CHAT_SESSION_SECRET=

# --- Chat model: the first configured provider wins -------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Any OpenAI-compatible endpoint instead:
LLM_BASE_URL=
LLM_API_KEY=
# Override the provider's default model (e.g. claude-haiku-4-5, gemini-flash-latest)
LLM_MODEL=

# Web search: the chatbot's source for facts about the turbine, project and community
TAVILY_API_KEY=

# Live weather at the turbine (OpenWeather "current weather"); drives clouds, rain and fog on the screens
OPENWEATHER_API_KEY=

# Photos in the chat (Unsplash). Only the access key is used; keep the secret key out of the repo.
UNSPLASH_ACCESS_KEY=
# Where the turbine stands (sun position + weather). Defaults to Lawrence Weston, Bristol.
SITE_LAT=51.52
SITE_LON=-2.69

# Cesium ion can provide the Google Photorealistic 3D Tiles used by the site viewer.
# Enable Google Photorealistic 3D Tiles for this ion account and use a scoped token.
VITE_CESIUM_ION_TOKEN=
# Optional direct Google Map Tiles API access (requires a Google Cloud billing account).
# Restrict this browser key to Map Tiles API and your website origins.
VITE_GOOGLE_MAP_TILES_API_KEY=
VITE_SITE_LAT=51.5388355
VITE_SITE_LON=-2.6717359
# Optional surveyed ellipsoid height of the foundation; otherwise sample Google tiles.
VITE_TURBINE_GROUND_HEIGHT_M=
VITE_TURBINE_HEADING_DEG=0
VITE_TURBINE_HEIGHT_OFFSET_M=0
VITE_TURBINE_SCALE=1

# --- Data -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ace_user
PGPASSWORD=ace_password
PGDATABASE=ace_wind

# Signs dataset download links; Resend sends them by email (optional)
DATASET_SECRET_KEY=
RESEND_API_KEY=
