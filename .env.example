# Copy to .env and fill in. Never commit .env or private keys.
# Local development: `docker compose -f compose.dev.yaml up -d`, then `npm run dev`.
# In production (NODE_ENV=production) the app refuses to start without the "required" ones.
# devpass and devredis below are only for the localhost-only development Compose stack.
# Replace every development password before using a production server.

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Public https:// origin of the site, used for QR codes (required in production)
PUBLIC_ORIGIN=http://localhost:5173

# --- Database (TimescaleDB + pgvector) ---------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ace
PGPASSWORD=devpass
PGDATABASE=ace_wind

# --- Redis (pub/sub, cache, rate limits, locks); include the password ---------
REDIS_URL=redis://:devredis@127.0.0.1:6379
# Production compose builds REDIS_URL from this:
REDIS_PASSWORD=

# --- Secrets: at least 32 random characters each (required in production) -----
CHAT_SESSION_SECRET=

# --- Chat model ---------------------------------------------------------------
# Simplest: just set ANTHROPIC_API_KEY (Claude Haiku 5.5 via Anthropic's OpenAI-compatible endpoint).
ANTHROPIC_API_KEY=
# Or any OpenAI-compatible endpoint (all three together; they override the above):
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Knowledge base embeddings (any /v1/embeddings server; default: local model) ---
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Data sources ---------------------------------------------------------------
# Live weather at the turbine (OpenWeather "current weather")
OPENWEATHER_API_KEY=
# Years of history to keep (never earlier than commissioning), or an exact HISTORY_START
HISTORY_YEARS=4

# --- Optional services ------------------------------------------------------------
# Web search for the chat
TAVILY_API_KEY=
# Photos in the chat (only the access key is used)
UNSPLASH_ACCESS_KEY=

# --- Frontend build (baked into the website at build time) ---------------------------
VITE_CESIUM_ION_TOKEN=
VITE_GOOGLE_MAP_TILES_API_KEY=

# Deployment credentials are GitHub Actions secrets, not entries in this file:
# DEPLOY_HOST       production SSH host or IP
# DEPLOY_SSH_KEY    private SSH key for the deployment account
# DEPLOY_KNOWN_HOSTS verified SSH host-key entry
# See README.md > Deployment. Never paste their values into Git, an issue, or a PR.
