# Copy to .env and fill in. Never commit .env.

PORT=4100
# Public URL of this site, used in the hoardings' QR codes (e.g. https://westonwind.org)
PUBLIC_ORIGIN=
# Set to 1 when running behind a reverse proxy (correct client IPs for rate limits)
TRUST_PROXY=0

# Protects /admin and /api/admin. Always set this on a public deployment.
ADMIN_TOKEN=

# Signs anonymous chat sessions. Set a long random value so chats survive restarts.
CHAT_SESSION_SECRET=

# --- Chat model: the first configured provider wins -------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Any OpenAI-compatible endpoint instead:
LLM_BASE_URL=
LLM_API_KEY=
# Override the provider's default model (e.g. claude-haiku-4-5, gpt-4.1-mini)
LLM_MODEL=

# Web search: the chatbot's source for facts about the turbine, project and community
TAVILY_API_KEY=

# Live weather at the turbine (OpenWeather "current weather"); drives clouds, rain and fog on the screens
OPENWEATHER_API_KEY=

# Photos in the chat (Unsplash). Only the access key is used; keep the secret key out of the repo.
UNSPLASH_ACCESS_KEY=
# Where the turbine stands (sun position + weather). Defaults to Lawrence Weston, Bristol.
SITE_LAT=51.52
SITE_LON=-2.69

# Cesium ion can provide the Google Photorealistic 3D Tiles used by the site viewer.
# Enable Google Photorealistic 3D Tiles for this ion account and use a scoped token.
VITE_CESIUM_ION_TOKEN=
# Optional direct Google Map Tiles API access (requires a Google Cloud billing account).
# Restrict this browser key to Map Tiles API and your website origins.
VITE_GOOGLE_MAP_TILES_API_KEY=
VITE_SITE_LAT=51.5378881
VITE_SITE_LON=-2.6740022
# Optional surveyed ellipsoid height of the foundation; otherwise sample terrain.
VITE_TURBINE_GROUND_HEIGHT_M=
VITE_TURBINE_HEADING_DEG=0
VITE_TURBINE_HEIGHT_OFFSET_M=0
VITE_TURBINE_SCALE=1

# --- Data -------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=ace_user
PGPASSWORD=
PGDATABASE=ace_wind

# Signs dataset download links; Resend sends them by email (optional)
DATASET_SECRET_KEY=
RESEND_API_KEY=

# Presentation-safe default. Switch only after the explicit migration and acceptance checks.
HISTORY_BACKEND=legacy
HISTORY_SYNC_ENABLED=1
HISTORY_SITE=ace
HISTORY_ASSET=wec-1
HISTORY_START=2026-07-21T10:40:00Z
HISTORY_SYNC_MS=600000
HISTORY_LOOKBACK_HOURS=24
HISTORY_STALE_MINUTES=30
ACE_TIMEOUT_MS=15000
# Relative paths work locally; Compose sets portable /data paths inside containers.
DATA_DIR=data
ZENODO_DIR=data/zenodo
HISTORY_OPERATIONS_DIR=data/operations
# Local Python must have scripts/history_requirements.txt installed. Docker includes it.
HISTORY_PYTHON=python
TIMESCALE_IMAGE=timescale/timescaledb@sha256:6f139d56042989bd35f50ba5986e492cd32e35cc6778c50be2659add298dc09f
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
# Mount a real off-host destination before setting this to 1.
BACKUP_COPY_OFFHOST=0
BACKUP_OFFHOST_PATH=./data/offhost
