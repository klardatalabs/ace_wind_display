{
  "name": "ace-wind-display",
  "version": "1.0.0",
  "description": "Weston Wind: live hoarding screens, phone chat and website for the ACE community wind turbine",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "npm install && npm --prefix frontend install",
    "dev": "node --watch server/bin/dev.js",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "node server/bin/dev.js",
    "start:api": "node server/bin/api.js",
    "start:collector": "node server/bin/collector.js",
    "db:migrate": "node server/bin/migrate.js",
    "knowledge": "node server/bin/knowledge.js",
    "knowledge:eval": "node server/knowledge/eval/retrievalEval.mjs",
    "test": "node --test \"server/**/*.test.mjs\"",
    "render:stills": "node scripts/render-stills.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "hyparquet": "1.31.2",
    "hyparquet-compressors": "1.1.2",
    "ioredis": "6.0.0",
    "mammoth": "1.13.0",
    "openai": "7.25.0",
    "pg": "8.23.0",
    "pgvector": "0.3.0",
    "unpdf": "1.8.1",
    "ws": "8.22.0"
  }
}
